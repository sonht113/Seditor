{
  "name": "seditor-svelte",
  "version": "1.1.0",
  "description": "Svelte bindings for Seditor.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "seditor-core": "workspace:*"
  },
  "peerDependencies": {
    "lexical": "^0.49.0",
    "svelte": "^4.0.0"
  },
  "devDependencies": {
    "seditor-tsconfig": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "@testing-library/svelte": "^4.0.0",
    "jsdom": "^24.0.0",
    "lexical": "^0.49.0",
    "svelte": "^4.0.0",
    "svelte-check": "^4.0.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^2.0.0"
  }
}
